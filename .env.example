# Секреты для формы «Запишись в команду» (server/api/join.post.ts).
# Скопируй в .env и впиши реальные значения. В Vercel добавь те же ключи
# в Project → Settings → Environment Variables.

# Supabase (Project → Settings → API)
NUXT_SUPABASE_URL=https://XXXX.supabase.co
# service_role key — ТОЛЬКО на сервере, никогда не кладём на клиент
NUXT_SUPABASE_SERVICE_KEY=eyJ...service_role...

# Telegram (бот уже есть)
NUXT_TELEGRAM_BOT_TOKEN=123456789:AA...
# chat_id группы/чата, куда слать заявки (для группы — отрицательный, напр. -1001234567890)
NUXT_TELEGRAM_CHAT_ID=-100XXXXXXXXXX
